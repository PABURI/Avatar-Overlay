#include <winver.h>
#include "version.h"   // build.bat 이 VERSION 파일을 읽어 build\version.h 로 생성한다

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "FileDescription", "Avatar Overlay"
      VALUE "ProductName", "Avatar Overlay"
      VALUE "ProductVersion", VER_STR
      VALUE "FileVersion", VER_STR
      VALUE "OriginalFilename", "AvatarOverlay.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 0x04B0
  END
END
